# ─── Database (MySQL 8 / MariaDB) ─────────────────────────────
# Any cloud MySQL works: PlanetScale, Aiven, Railway, TiDB Cloud, Hostinger...
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://user:password@host:3306/thundergym"

# ─── Security ─────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me"

# ─── Gym identity ─────────────────────────────────────────────
NEXT_PUBLIC_GYM_NAME="ThunderGym"
ADMIN_PHONE="201000000000"
